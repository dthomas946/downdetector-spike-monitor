FROM python:3.12-slim
WORKDIR /app
COPY downdetector_spike_monitor/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY downdetector_spike_monitor/app ./app
COPY downdetector_spike_monitor/watchlist.example.yaml .
EXPOSE 8099
CMD ["sh", "-c", "[ -f /data/watchlist.yaml ] || (mkdir -p /data && cp watchlist.example.yaml /data/watchlist.yaml); uvicorn app.main:app --host 0.0.0.0 --port 8099"]
